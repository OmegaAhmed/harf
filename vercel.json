{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "apps/web/dist",
  "routes": [
    {
      "src": "/api/v1/(.*)",
      "dest": "/api/harf.js",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/v1/$1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|api$|assets/|assets$|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
